{
  "name": "isochrone",
  "version": "1.0.0",
  "private": true,
  "description": "Reachability map — isochrone explorer with Mapbox",
  "keywords": [
    "isochrone",
    "mapbox",
    "reachability"
  ],
  "license": "MIT",
  "author": "Dean Grant",
  "type": "module",
  "scripts": {
    "analyze:bundle": "ANALYZE=true pnpm --filter web build",
    "build": "pnpm --filter web build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev": "pnpm --filter web dev",
    "doctor": "react-doctor",
    "doctor:changed": "react-doctor --verbose --scope changed --yes",
    "doctor:full": "react-doctor --verbose --yes",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:lockfile": "pnpm install --frozen-lockfile",
    "test": "pnpm --filter web test",
    "validate:skills": "node scripts/validate-skills.mjs",
    "verify": "pnpm validate:skills && pnpm exec biome ci . && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "react-doctor": "catalog:",
    "ultracite": "catalog:"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  }
}
